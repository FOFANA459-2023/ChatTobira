# The pipeline's working directory holds rendered page images and vision
# transcripts — hundreds of megabytes of derived data that must never be
# baked into an image. It is mounted at run time instead.
.work
../.work

__pycache__
*.pyc
.pytest_cache
.ruff_cache
*.egg-info
.venv
venv

# Credentials belong in the environment, never in a layer.
.env
.env.*

.git
.gitignore
Dockerfile
.dockerignore
