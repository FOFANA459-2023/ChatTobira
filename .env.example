# Copy to .env and fill in. NEVER commit .env — see .gitignore.

# --- Source materials -------------------------------------------------------
# Absolute path to the folder holding "Foundation 2", "Foundation 3", "Intermediate".
# Defaults to the repo root, where they already live.
MATERIALS_ROOT=.
# Scratch space for converted PDFs, rendered page images, and the resume manifest.
WORK_DIR=./.work

# --- Google AI Studio -------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OPTIONAL extra keys, each from a DIFFERENT Google Cloud project. Free-tier
# daily buckets are per project and per model, so a second key genuinely
# doubles the pages transcribable per day. Supported: _2 through _5.
GOOGLE_API_KEY_2=
# gemini-2.5-flash was retired for new API projects; 3.6 is the current stable Flash.
VISION_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# --- Groq -------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
CHAT_MODEL=llama-3.3-70b-versatile
# Quiz generation needs Groq's json_schema structured output, which only the
# gpt-oss models implement — llama-3.3 rejects it and the quiz would silently
# fall through to Gemini's 20-requests/day budget.
QUIZ_MODEL=openai/gpt-oss-120b
# Speech-to-text for spoken turns. No language is pinned: students speak
# Japanese or English and Whisper detects which.
STT_MODEL=whisper-large-v3-turbo

# Text-to-speech for the tutor's spoken reply. Groq serves no TTS model at all
# — ask its /models endpoint and the key returns two Whisper builds — so the
# voice comes from Gemini on the GOOGLE_API_KEY below. Returns raw 24kHz PCM,
# which the /api/speak route wraps in a WAV header for the browser.
# The browser's own speechSynthesis is the automatic fallback when this fails,
# so an unset key costs voice quality rather than the feature.
TTS_MODEL=gemini-2.5-flash-preview-tts
# A prebuilt Gemini voice. Kore reads Japanese clearly and unhurriedly.
TTS_VOICE=Kore

# --- DeepSeek (optional) ----------------------------------------------------
# https://platform.deepseek.com/api_keys — prepaid, no daily request cap (only
# a concurrency limit), so it absorbs overflow once Groq's free 1,000/day is
# spent. Sits BETWEEN Groq and Gemini: Groq stays the free fast path, Gemini
# stays the last resort, and the Google key is left for vision + embeddings.
# Leave blank to keep the original Groq -> Gemini behaviour.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Auth email sending -------------------------------------------------------
# Gmail account configured as Supabase's custom SMTP sender, plus its app
# password (https://myaccount.google.com/apppasswords). `ingest bounces` reads
# this inbox over IMAP to revoke invites whose email bounced downstream.
SMTP_SENDER=
SMTP_APP_PASSWORD=

# --- Backup ------------------------------------------------------------------
# Private Supabase Storage bucket for `ingest backup` / `ingest restore`:
# mirrors the source PDFs and .work transcripts so no machine is
# irreplaceable. Never served by the app.
BACKUP_BUCKET=chattobira-backup

# --- Supabase ---------------------------------------------------------------
# Direct Postgres connection (session pooler), used by ingest for bulk writes.
# CAUTION: an '@' in the password must be URL-encoded as %40.
DATABASE_URL=
SUPABASE_URL=
# Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Citations --------------------------------------------------------------
# Only these three textbooks may be cited. Class handouts still ground answers
# but are never named in a citation. Paths are relative to MATERIALS_ROOT.
CITABLE_SOURCES=Foundation 2/Foundation 1 & 2.pdf|Intermediate/Tobira Intermediate Japanese.pdf|Intermediate/Tobira Kanji and Vocabulary Intermediate Japanese.pdf|Foundation 3/Foundation 3 Textbook.pdf
# Max characters of quoted textbook text per citation. Keeps excerpts short.
CITATION_QUOTE_CHARS=200

# --- Cloudflare AI Gateway (optional but recommended) -----------------------
# Fronts Groq + Google with caching, retries, and fallback.
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_NAME=chattobira

# --- Ingest tuning ----------------------------------------------------------
# Pages sent to the vision model per request. 4 balances cost against context bleed.
VISION_PAGES_PER_REQUEST=4
RENDER_DPI=200
# Seconds between vision calls. Google free tier is ~10 RPM; 7s keeps you under it.
VISION_THROTTLE_SECONDS=7
