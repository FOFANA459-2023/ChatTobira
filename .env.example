# Copy to .env and fill in. NEVER commit .env — see .gitignore.

# --- Source materials -------------------------------------------------------
# Absolute path to the folder holding "Foundation 2", "Foundation 3", "Intermediate".
# Defaults to the repo root, where they already live.
MATERIALS_ROOT=.
# Scratch space for converted PDFs, rendered page images, and the resume manifest.
WORK_DIR=./.work

# --- Google AI Studio -------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# gemini-2.5-flash was retired for new API projects; 3.6 is the current stable Flash.
VISION_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# --- Groq -------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
CHAT_MODEL=llama-3.3-70b-versatile
STT_MODEL=whisper-large-v3-turbo

# --- Supabase ---------------------------------------------------------------
# Direct Postgres connection (session pooler), used by ingest for bulk writes.
# CAUTION: an '@' in the password must be URL-encoded as %40.
DATABASE_URL=
SUPABASE_URL=
# Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Citations --------------------------------------------------------------
# Only these three textbooks may be cited. Class handouts still ground answers
# but are never named in a citation. Paths are relative to MATERIALS_ROOT.
CITABLE_SOURCES=Foundation 2/Foundation 1 & 2.pdf|Intermediate/Tobira Intermediate Japanese.pdf|Intermediate/Tobira Kanji and Vocabulary Intermediate Japanese.pdf
# Max characters of quoted textbook text per citation. Keeps excerpts short.
CITATION_QUOTE_CHARS=200

# --- Cloudflare AI Gateway (optional but recommended) -----------------------
# Fronts Groq + Google with caching, retries, and fallback.
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_NAME=chattobira

# --- Ingest tuning ----------------------------------------------------------
# Pages sent to the vision model per request. 4 balances cost against context bleed.
VISION_PAGES_PER_REQUEST=4
RENDER_DPI=200
# Seconds between vision calls. Google free tier is ~10 RPM; 7s keeps you under it.
VISION_THROTTLE_SECONDS=7
